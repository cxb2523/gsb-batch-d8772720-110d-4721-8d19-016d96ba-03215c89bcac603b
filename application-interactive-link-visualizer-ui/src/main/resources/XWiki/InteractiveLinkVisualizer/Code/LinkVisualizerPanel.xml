    <property>
      <code>require(['jquery', 'visualisationAPI', 'linkGraphCollector', 'xwiki-meta'], function($, visualisationAPI, collector, xm) {
    const panelContainer = document.getElementById('sigma-container-panel');
    // Skip when the panel DOM is absent, and run only once even if the
    // JavaScriptExtension is evaluated more than once (DOM updated events).
    if (!panelContainer || panelContainer.getAttribute('data-init-done') === 'true') {
        return;
    }
    if (panelContainer) {
        panelContainer.setAttribute('data-init-done', 'true');
    }

    const solrServiceURL = new XWiki.Document('SuggestSolrService', 'XWiki').getURL('get');
    #template('colorThemeInit.vm') // For XWiki color theme variables
    var themeColors = $jsontool.serialize({
        'nodeColor': $theme.linkColor,
        'labelColor': $theme.textColor,
        'fadeColor': $theme.highlightColor,
        'labelContainerColor': $theme.pageContentBackgroundColor
    });

    // Row limit applied to every Solr query of a collection, kept identical
    // to the previous single-search implementation.
    const NB = 1000;
    // Reference of the currently opened document, in the Solr reference format.
    const rootReference = 'document:' + xm.wiki + ':' + xm.document;

    // Localized user-facing strings, rendered by Velocity and JSON-escaped so
    // quotes or special characters in translations cannot break the JS.
    const messages = $jsontool.serialize({
        'loading': "$services.localization.render('intlv.panel.status.loading')",
        'empty': "$services.localization.render('intlv.panel.status.empty')",
        'error': "$services.localization.render('intlv.panel.status.error')",
        'summary': "$services.localization.render('intlv.panel.status.summary')",
        'truncated': "$services.localization.render('intlv.panel.warning.truncated')"
    });

    function formatMessage(template, args) {
        return template.replace(/\{(\d+)\}/g, function(match, index) {
            const position = Number(index);
            return args[position] !== undefined &amp;&amp; args[position] !== null
                ? String(args[position]) : match;
        });
    }

    const depthSelect = document.getElementById('ilv-depth-select');
    const statusElement = document.getElementById('ilv-panel-status');
    const warningElement = document.getElementById('ilv-panel-warning');

    // Only the latest collection may update the graph: a response coming back
    // after the user changed the depth (or re-triggered a search) is rejected
    // by the runner and ignored.
    const requestRunner = new collector.LatestRequestRunner();

    function setStatus(message) {
        statusElement.textContent = message;
    }

    function setWarning(message) {
        if (message) {
            warningElement.textContent = message;
            warningElement.hidden = false;
        } else {
            warningElement.textContent = '';
            warningElement.hidden = true;
        }
    }

    function describeLayers(layerStats) {
        // Skip the synthetic seed layer (layer 0) in the user-facing summary.
        return layerStats.filter(function(stat) {
            return stat.layer &gt; 0;
        }).map(function(stat) {
            return 'L' + stat.layer + ': +' + stat.newDocuments
                + ' (' + stat.totalDocuments + ')';
        }).join(', ');
    }

    function resolvePageURL(reference) {
        return new XWiki.Document(XWiki.Model.resolve(reference)).getURL();
    }

    // Bridges jQuery $.post to the postSolrQuery signature expected by the
    // collector. The Solr entry point and parameters (outputSyntax, nb,
    // media, query, input) are unchanged from the previous implementation.
    function postSolrQuery(url, params) {
        return Promise.resolve($.post(url, params));
    }

    function disposePreviousGraph() {
        // visualize() already disposes a previous renderer on the same
        // container; this also covers the "no result" redraw.
        visualisationAPI.disposeVisualization('sigma-container-panel');
    }

    function collectAndDraw() {
        const maxDepth = parseInt(depthSelect.value, 10) || collector.MIN_DEPTH;
        setStatus(messages.loading);
        setWarning('');
        requestRunner.run(function() {
            return collector.collectLinkGraph({
                rootReference: rootReference,
                maxDepth: maxDepth,
                nb: NB,
                solrServiceURL: solrServiceURL,
                postSolrQuery: postSolrQuery
            });
        }).then(function(result) {
            if (result.documents.size === 0) {
                disposePreviousGraph();
                setStatus(messages.empty);
                setWarning('');
                return;
            }

            const graphData = collector.buildGraph(result, themeColors, resolvePageURL);
            disposePreviousGraph();
            visualisationAPI.visualize(graphData, 'sigma-container-panel', themeColors, true, NB);

            setStatus(formatMessage(messages.summary, [
                result.documents.size,
                graphData.edges.length,
                describeLayers(result.layerStats)
            ]));

            if (result.truncated) {
                setWarning(formatMessage(messages.truncated, [
                    result.nb,
                    result.truncatedAtLayer
                ]));
            } else {
                setWarning('');
            }
        }).catch(function(error) {
            if (error instanceof collector.StaleRequestError) {
                // A newer request is running, this response must not touch
                // the graph nor the status line.
                return;
            }
            setStatus(messages.error);
            setWarning('');
        });
    }

    // Populate the depth choices from the supported range (1..3).
    for (let depth = collector.MIN_DEPTH; depth &lt;= collector.MAX_DEPTH; depth++) {
        const option = document.createElement('option');
        option.value = depth.toString();
        option.textContent = depth.toString();
        if (depth === collector.MIN_DEPTH) {
            option.selected = true;
        }
        depthSelect.appendChild(option);
    }

    // Re-collect and redraw whenever the depth changes.
    depthSelect.addEventListener('change', collectAndDraw);

    collectAndDraw();
});</code>
