# The API edge (Caddy) sets its own headers; these apply only to the static site.
# `payment` is intentionally unrestricted, and COOP allows popups for the cross-origin Razorpay checkout.
# The CSP is report-only until the console is clean on the map, a company card and the donate flow.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://checkout.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; connect-src 'self' https://jobdex-api.1mindlabs.org https://api.github.com https://*.razorpay.com; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'

# Vite content-hashes everything under /assets, so it can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
