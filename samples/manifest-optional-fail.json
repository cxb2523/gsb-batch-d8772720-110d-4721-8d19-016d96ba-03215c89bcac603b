{
  "name": "情形二 · 单项非必需失败",
  "description": "必需来源全部成功；非必需的设备 OEE 服务返回体超过 64 KiB 被判失败，仅记录原因，不阻断后续、不影响整轮可信度。",
  "defaultTimeoutMs": 8000,
  "items": [
    {
      "id": "line-status",
      "source": "产线状态服务",
      "url": "data/line-status.json",
      "required": true,
      "timeoutMs": 4000,
      "fields": [
        { "path": "lineName", "label": "产线名称" },
        { "path": "status", "label": "运行状态" },
        { "path": "shift", "label": "班次" }
      ]
    },
    {
      "id": "output",
      "source": "产量计数器",
      "url": "data/output.json",
      "required": true,
      "timeoutMs": 4000,
      "fields": [
        { "path": "planned", "label": "计划产量" },
        { "path": "actual", "label": "实际产量" },
        { "path": "unit", "label": "单位" }
      ]
    },
    {
      "id": "quality",
      "source": "质量检测系统",
      "url": "data/quality.json",
      "required": true,
      "timeoutMs": 4000,
      "fields": [
        { "path": "inspected", "label": "检验数" },
        { "path": "defects", "label": "缺陷数" },
        { "path": "fpyPercent", "label": "一次通过率(%)" }
      ]
    },
    {
      "id": "equipment",
      "source": "设备 OEE 服务（响应体超限样例）",
      "url": "data/equipment-oversize.json",
      "required": false,
      "timeoutMs": 4000,
      "fields": [
        { "path": "equipmentId", "label": "设备编号" },
        { "path": "oeePercent", "label": "OEE(%)" },
        { "path": "mtbfHours", "label": "MTBF(小时)" }
      ]
    },
    {
      "id": "weather",
      "source": "车间温湿度（非必需，地址缺失）",
      "url": "data/missing-weather.json",
      "required": false,
      "timeoutMs": 2000,
      "fields": [
        { "path": "temperatureC", "label": "温度(℃)" },
        { "path": "humidityPercent", "label": "湿度(%)" }
      ]
    }
  ]
}
