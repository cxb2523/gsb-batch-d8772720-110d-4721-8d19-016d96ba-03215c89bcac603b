# ==================== Python ====================
__pycache__/
*.py[cod]
*$py.class
*.pyc

# ==================== 日志 ====================
scrapy.log
*.log

# ==================== 运行时产物 ====================
# 爬虫下载的图片与商品 JSON 数据（可用 --from-json 重新导入，无需入库）
images/
data/
# 防止从 scripts/ 直接运行爬虫时生成错位产物目录（统一落点已改为项目根）
scripts/data/
scripts/images/

# 列表采集缓冲落盘（flush 失败时的恢复文件，非源码）
pending_product_links.jsonl

# ==================== 本地/工具目录 ====================
# WorkBuddy 记忆与缓存（非项目代码）
.workbuddy/

# 旧版本与压缩包归档（历史备份，不纳入版本控制）
archive/

# ==================== 系统 ====================
.DS_Store
Thumbs.db
